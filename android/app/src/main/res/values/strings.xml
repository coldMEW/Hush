    <!-- Ad handling -->
    <string name="section_mode">When an ad plays</string>
    <string name="mode_skip">Skip</string>
    <string name="mode_skip_desc">Restarts Spotify in the background to drop the ad break. Music is back in a few seconds.</string>
    <string name="mode_mute">Mute</string>
    <string name="mode_mute_desc">Silences the ad and turns the sound back on when it ends. Works without Shizuku.</string>
    <string name="mode_off">Do nothing</string>
    <string name="mode_off_desc">Ads play. The DNS filter still runs if it\'s on.</string>

