    <!-- Shizuku setup -->
    <string name="sz_title">Set up Shizuku</string>
    <string name="sz_intro">Hush needs Shizuku to restart Spotify when an ad starts. Shizuku is a free, open-source app that lets apps use the system tools Android normally keeps for computers. Setup takes about two minutes, once.</string>
    <string name="sz_done">Shizuku is ready. Hush will now skip ads.</string>
    <string name="sz_step_done">Done</string>
    <string name="sz_install">1. Install Shizuku</string>
    <string name="sz_install_desc">From Google Play, or from its official GitHub page.</string>
    <string name="sz_dev">2. Turn on Developer options</string>
    <string name="sz_dev_desc">In About phone, tap Build number seven times.</string>
    <string name="sz_start">3. Start Shizuku</string>
    <string name="sz_start_desc">In Shizuku, choose Start via Wireless debugging and follow its pairing steps. Pairing is needed only once.</string>
    <string name="sz_start_desc_old">On this Android version Shizuku is started from a computer with adb. Open Shizuku for the command.</string>
    <string name="sz_allow">4. Allow Hush</string>
    <string name="sz_allow_desc">Hush asks for this as soon as Shizuku is running.</string>
    <string name="sz_note">Shizuku stops when the phone restarts. Open it and tap Start again; Hush reminds you if it has to mute an ad because of that.</string>
    <string name="sz_guide">Shizuku\'s setup guide</string>

